/* ==========================================================================
   底部导航（自定义 TabBar）的样式已抽到公共文件，与首页 / 导览页共用：
      styles/tabbar.wxss
   ⚠️ @import 必须写在文件最前面。 */
@import "../../styles/tabbar.wxss";

/* ==========================================================================
   pages/appreciate/appreciate.wxss — 鉴赏页样式
   --------------------------------------------------------------------------
   设计稿：Figma「鉴赏页」（node 61:121），基准 430 × 932（iPhone 15 Pro）
   单位方案：vw —— 与 app.wxss 约定一致，所有尺寸写 calc(设计稿px / 430 * 100vw)

   布局方式：本页是一版「整屏构图」（背景 + 悬浮展品 + 下方说明），
            各块之间没有文档流关系，因此统一用 absolute 按设计稿坐标摆放。
            （绝对定位是本页的必要手段，不是偷懒：主图与左右箭头在纵向互相重叠，
             用 flex 反而要写一堆负 margin 去凑。）
   ========================================================================== */

/* ==========================================================================
   一、页面容器
   --------------------------------------------------------------------------
   固定一屏、不滚动（与设计稿一致），内容超出部分裁掉。
   ========================================================================== */
.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: var(--bg-default);
}

/* ==========================================================================
   二、渐变背景层
   --------------------------------------------------------------------------
   设计稿：430 × 864，三段线性渐变
             156.2486° · 辅助色 6.6017% → 白 54.035% → 主色 99.678%
   实测色值与 app.wxss 令牌完全一致（#c8b39b / #a57b52），故直接引用令牌。
   ========================================================================== */
.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: calc(864 / 430 * 100vw);
  /*
   * 两层背景（先写的在上）：
   *   1) 10% 纯黑 —— 整体压暗。
   *      设计稿量得的明度比「导出 CSS 直出」暗约 13%（浅处 244→211）。
   *      这里先补 10%，剩下的约 3% 由上面的 .bg__grain 颗粒层带出来，
   *      合起来与设计稿一致。嫌深/浅就只调这一个数字。
   *   2) 三段主渐变（156.2486° 辅助色 → 白 → 主色）
   */
  background-image: linear-gradient(
      rgba(0, 0, 0, 0.1),
      rgba(0, 0, 0, 0.1)
    ),
    linear-gradient(
      156.2486deg,
      var(--brand-secondary) 6.6017%,
      #ffffff 54.035%,
      var(--brand-primary) 99.678%
    );
  background-repeat: no-repeat, no-repeat;
  background-size: 100% 100%, 100% 100%;
}

/* --------------------------------------------------------------------------
   颗粒纹理层
   --------------------------------------------------------------------------
   设计稿的渐变层带「噪点」填充（横向逐像素随机、振幅约 6 个灰阶），
   但 Figma 的代码导出只给 linear-gradient，噪点不会带出来 ——
   真机上就少了这层质感 / 陶瓷的粗颗粒感。

   还原方式：一张 64 × 64 的 8bit 灰度随机噪点图平铺
             （64px 对应设计稿 64 个单位 → 每个噪点 = 1 个单位，与设计稿颗粒同粗）。
   为什么用 base64 内联：WXSS 的 background-image 【不支持本地路径】，
             只能用网络图或 base64（项目里 splash 的箭头也是这么处理的）。
             整张 64×64 灰度 PNG 只有 4.2KB，base64 后约 5.5KB，可接受。
   -------------------------------------------------------------------------- */
.bg__grain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: calc(864 / 430 * 100vw);
  opacity: 0.095;
  background-image: url("data:image/png;base64,");
  background-repeat: repeat;
  background-size: calc(64 / 430 * 100vw) calc(64 / 430 * 100vw);
}

/* ==========================================================================
   三、导航栏
   --------------------------------------------------------------------------
   设计稿：条高 52，顶边 y=75（= 状态栏 54 + 21），标题与搜索图标在其中垂直居中。
   状态栏高度由 appreciate.js 注入 --status-bar-h，避免标题被刘海 / 灵动岛压住。
   ========================================================================== */
.navbar {
  position: absolute;
  top: calc(var(--status-bar-h, 44px) + 21 / 430 * 100vw);
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: calc(52 / 430 * 100vw);
}

/* 标题「赏文物」：26px / 行高 22 / 一级文字 */
.navbar__title {
  font-family: var(--font-serif);
  font-size: calc(26 / 430 * 100vw);
  line-height: calc(22 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

/* 搜索图标：24 × 24，右边距 30（设计稿 x=376，376+24+30 = 430） */
.navbar__search {
  position: absolute;
  right: calc(30 / 430 * 100vw);
  width: calc(24 / 430 * 100vw);
  height: calc(24 / 430 * 100vw);
}

.navbar__search--hover {
  opacity: 0.6;
}

.navbar__icon {
  width: 100%;
  height: 100%;
}

/* ==========================================================================
   四、分类「陶 | 瓷」
   --------------------------------------------------------------------------
   设计稿：居中，顶边 y=158，22px / 行高 24 / 字距 12。
   两段不同色是设计稿原本的拆分（不是笔误）：
     「陶」一级文字， 「|瓷」二级文字。
   ========================================================================== */
.category {
  position: absolute;
  top: calc(158 / 430 * 100vw);
  right: 0;
  left: 0;
  /*
   * ⚠️ 字距补偿
   * ------------------------------------------------------------------
   * CSS 的 letter-spacing 会在【每个字后面】都补一份间距，包括最后一个字。
   * 居中时这段「尾巴」也算进宽度，于是整段文字看上去比几何中心偏左 字距/2
   * （本例 12px 字距 → 偏左 6px）。Figma 按字墨居中，没有这个偏移。
   * 补一个等宽的左内边距把内容盒左边收窄，居中结果就右移 字距/2，与设计稿对齐。
   */
  padding-left: calc(12 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(22 / 430 * 100vw);
  line-height: calc(24 / 430 * 100vw);
  letter-spacing: calc(12 / 430 * 100vw);
  text-align: center;
}

/*
 * ⚠️ 每条 <text> 都显式声明 font-family
 * --------------------------------------------------------------------------
 * 小程序 <text> 组件对「父级 font-family」的继承不稳定，只靠 .category 上
 * 那一句可能命中不了，会被系统用无衬线体（黑体）兜底。
 * 见 app.wxss「字体」段落里的实测说明。
 */
.category__on {
  font-family: var(--font-serif);
  color: var(--text-level-1);
}

.category__off {
  font-family: var(--font-serif);
  color: var(--text-level-2);
}

/* ==========================================================================
   五、展品舞台
   --------------------------------------------------------------------------
   设计稿：430 × 573，水平居中、顶边 y=126。
   ⚠️ 主图素材是「抠图」（75% 面积透明），叠在渐变背景上呈现悬浮感，
      所以这里用 aspectFit 而不是 aspectFill —— 素材与容器比例本就一致
      （860/1146 = 430/573 = 0.7504），两者结果相同，但 aspectFit 不会误裁。
   ========================================================================== */
.stage {
  position: absolute;
  top: calc(126 / 430 * 100vw);
  right: 0;
  left: 0;
  height: calc(573 / 430 * 100vw);
}

.stage__img {
  width: 100%;
  height: 100%;
}

/* --- 左右切换箭头 ---
   设计稿：图标本体 14.456 × 26.228，纵向 y=418（舞台内 = 418-126 = 292），
          左右距屏幕边 12（12 与 403.544+14.456=418 → 右边距也是 12）。
   触摸热区：图标本身太窄（14px）不好点，用「padding 撑大 + 等量负 margin 抵消」
            把热区扩到约 38 × 54，而图标仍停在设计稿标注的位置上。 */
.stage__nav {
  position: absolute;
  top: calc(292 / 430 * 100vw);
  box-sizing: content-box;
  width: calc(14.456 / 430 * 100vw);
  height: calc(26.228 / 430 * 100vw);
  padding: calc(14 / 430 * 100vw) calc(12 / 430 * 100vw);
  margin: calc(-14 / 430 * 100vw) calc(-12 / 430 * 100vw);
  transition: opacity 0.18s ease;
}

.stage__nav--prev {
  left: calc(12 / 430 * 100vw);
}

.stage__nav--next {
  right: calc(12 / 430 * 100vw);
}

.stage__nav--hover {
  opacity: 0.55;
}

.stage__nav-icon {
  width: 100%;
  height: 100%;
}

/* ==========================================================================
   六、展品说明
   --------------------------------------------------------------------------
   设计稿：名称顶边 y=695（28px / 行高 22 / 字距 12），
          描述顶边 y=749（18px / 行高 24 / 字距 1.8）。
   两者行盒间距 = 749 - (695 + 22) = 32。
   ⚠️ 设计稿此处的 left 是 calc(50% + 1px) —— 即比几何居中右移 1px，
      照搬保留。
   ========================================================================== */
.caption {
  position: absolute;
  top: calc(695 / 430 * 100vw);
  right: 0;
  left: 0;
  font-family: var(--font-serif);
  text-align: center;
}

.caption__title {
  display: block;
  position: relative;
  left: calc(1 / 430 * 100vw);
  /* 字距补偿 12（= 字距），再叠加设计稿自带的 +1px —— 见 .category 的说明 */
  padding-left: calc(12 / 430 * 100vw);
  /* 见 .category__on：<text> 不吃父级字体，必须逐条声明 */
  font-family: var(--font-serif);
  font-size: calc(28 / 430 * 100vw);
  line-height: calc(22 / 430 * 100vw);
  letter-spacing: calc(12 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.caption__desc {
  display: block;
  position: relative;
  left: calc(1 / 430 * 100vw);
  /* 字距补偿 1.8（= 字距） */
  padding-left: calc(1.8 / 430 * 100vw);
  margin-top: calc(32 / 430 * 100vw);
  /* 见 .category__on：<text> 不吃父级字体，必须逐条声明 */
  font-family: var(--font-serif);
  font-size: calc(18 / 430 * 100vw);
  line-height: calc(24 / 430 * 100vw);
  letter-spacing: calc(1.8 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}
