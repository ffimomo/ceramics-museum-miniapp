/* ==========================================================================
   底部导航（自定义 TabBar）的样式已抽到公共文件，与首页 / 导览页 / 鉴赏页共用：
      styles/tabbar.wxss
   ⚠️ @import 必须写在文件最前面。 */
@import "../../styles/tabbar.wxss";

/* ==========================================================================
   pages/mine/mine.wxss — 我的（个人信息页）
   --------------------------------------------------------------------------
   设计稿：Figma「个人信息页」（node 65:268），基准 430 × 932（iPhone 15 Pro）
   单位方案：vw —— 与 app.wxss 约定一致，所有尺寸写 calc(设计稿px / 430 * 100vw)

   布局方式：
     · 顶部背景图 / 设置入口 / 用户信息 —— 三者互相叠放，用 absolute 按设计稿坐标摆
     · 内容面板起 —— 回到文档流（面板上压背景图用负 margin），
       面板内部的「订单区 + 菜单」按设计稿的行高与间距顺序排布，
       比逐行写死 top 更好维护，渲染结果与设计稿逐行一致。
   ========================================================================== */

/* ==========================================================================
   一、页面容器
   ========================================================================== */
.page {
  position: relative;
  min-height: 100vh;
  background-color: var(--bg-default);
}

/* ==========================================================================
   二、顶部背景图
   --------------------------------------------------------------------------
   设计稿：图框 430 × 360，原图 577 × 1024 以 cover + 底边对齐填充。
   小程序 image 没有 object-position，这里显式给出 cover 后的尺寸：
     scale = max(430/577, 360/1024) = 0.7452  →  430 × 763.1
   再 bottom: 0 贴底，多出来的上半部分由 .hero 裁掉（与设计稿的 bottom 对齐一致）。
   ========================================================================== */
.hero {
  position: relative;
  width: 100%;
  height: calc(360 / 430 * 100vw);
  overflow: hidden;
}

.hero__img {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: calc(763.1 / 430 * 100vw);
}

/* ==========================================================================
   三、设置入口（右上角齿轮）
   --------------------------------------------------------------------------
   设计稿：24 × 24，距顶 78、距右 37。
   ========================================================================== */
.settings {
  position: absolute;
  top: calc(78 / 430 * 100vw);
  right: calc(37 / 430 * 100vw);
  width: calc(24 / 430 * 100vw);
  height: calc(24 / 430 * 100vw);
}

.settings--hover {
  opacity: 0.6;
}

.settings__icon {
  width: 100%;
  height: 100%;
}

/* ==========================================================================
   四、用户信息
   --------------------------------------------------------------------------
   设计稿：头像 86 × 86 位于 (38, 110)；文字列左起 x = 148（= 38 + 86 + 24）。
           昵称 24px / 欢迎语 16px，同为白色（压在深色背景图上）。
   ========================================================================== */
.profile {
  position: absolute;
  top: calc(110 / 430 * 100vw);
  left: calc(38 / 430 * 100vw);
  display: flex;
  align-items: center;
}

/* 头像素材本身带圆形遮罩（四角透明），不需要再写 border-radius */
.profile__avatar {
  flex-shrink: 0;
  width: calc(86 / 430 * 100vw);
  height: calc(86 / 430 * 100vw);
}

.profile__text {
  margin-left: calc(24 / 430 * 100vw);
}

.profile__name {
  display: block;
  font-family: var(--font-sans);
  font-size: calc(24 / 430 * 100vw);
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-inverse);
}

.profile__desc {
  display: block;
  /* 昵称行盒底 154.8 → 欢迎语行盒顶 164，间距 9.2 */
  margin-top: calc(9.2 / 430 * 100vw);
  font-family: var(--font-sans);
  font-size: calc(16 / 430 * 100vw);
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-inverse);
}

/* ==========================================================================
   五、内容面板
   --------------------------------------------------------------------------
   设计稿里这是三块同色矩形（242→422 / 244→932 / 422→852）互相叠出来的效果，
   颜色都是 --bg-default，视觉上就是一块「顶部 32 圆角、上压背景图」的面板，
   等价合并成一块实现。
   面板顶 242，背景图底 360 → 上压 118。
   ========================================================================== */
.panel {
  position: relative;
  z-index: 1;
  margin-top: calc(-118 / 430 * 100vw);
  padding-bottom: var(--tabbar-h);
  background-color: var(--bg-default);
  border-radius: calc(32 / 430 * 100vw) calc(32 / 430 * 100vw) 0 0;
}

/* ==========================================================================
   5.1 我的订单
   --------------------------------------------------------------------------
   设计稿：区块 242 → 422。
           上内边距 34（→ 标题行盒顶 276），下内边距 26（→ 区块底 422）
   ========================================================================== */
.orders {
  /*
   * 下内边距：「这一块内容多高」与「区块底停在 422」之间的差额，靠它吸收，
   * 这样下面四条菜单的行位（423 / 500 / 577 / 653）始终不会被推跑。
   *   当前内容 = 标题 24 + 间距 30 + 图标 48 + 间距 8 + 文字行盒 19.2（16 × 1.2）= 129.2
   *   34（上内边距）+ 129.2 + 下内边距 = 422 - 242 = 180  →  下内边距 = 16.8
   * 历史上图标 42→48、文字 13→16 都是靠改这一个数字维持区块高度不变的。
   */
  padding: calc(34 / 430 * 100vw) 0 calc(16.8 / 430 * 100vw);
}

/* 区块头：「我的订单」在左（左起 36），「全部订单 + ›」在右（右边距 20） */
.orders__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: calc(24 / 430 * 100vw);
  padding-right: calc(20 / 430 * 100vw);
  padding-left: calc(36 / 430 * 100vw);
}

.orders__title {
  font-family: var(--font-sans);
  font-size: calc(20 / 430 * 100vw);
  /* ⚠️ PingFang SC 系统字体自带真实 Medium，不会像自定义宋体子集那样被合成加粗 */
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-level-1);
}

.orders__all {
  display: flex;
  align-items: center;
}

/*
 * 「全部订单」与 › 的间距
 * --------------------------------------------------------------------------
 * 设计稿明确给了「全部订单」的左基准 x = 318（文字宽 64 → 右边缘 382），
 * 而 ChevronRight 是 Simple Design System 组件、导出里没有坐标。
 * 本行右边距 20（与四条菜单一致，› 墨迹右缘 ≈ 409），
 * 由 410 - 8(箭头宽) - 382(文字右缘) = 20 反推出这个间距，
 * 这样「全部订单」正好落在设计稿标注的 318 上。
 */
.orders__all .chevron {
  margin-left: calc(20 / 430 * 100vw);
}

.orders__all--hover {
  opacity: 0.6;
}

.orders__all-text {
  font-family: var(--font-sans);
  font-size: calc(16 / 430 * 100vw);
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-level-2);
}

/* --------------------------------------------------------------------------
   通用右箭头 ›（订单入口 + 四条菜单共用同一张素材）
   设计稿来源是 Simple Design System 的 Chevron right 组件，
   Figma 未提供可导出的矢量，这里按 Design System 的样式重建了一张 8 × 14 的圆头折线。
   -------------------------------------------------------------------------- */
.chevron {
  flex-shrink: 0;
  width: calc(8 / 430 * 100vw);
  height: calc(14 / 430 * 100vw);
  margin-left: calc(4 / 430 * 100vw);
}

/* --------------------------------------------------------------------------
   四个订单状态
   设计稿：整体水平居中，间距 56；单项宽 42，图标 42 × 42，图标与文字间距 8，
          文字 13px 一级文字居中。行盒顶 330（= 区块顶 242 + 34 + 24 + 30）
   -------------------------------------------------------------------------- */
/*
 * 四个订单状态
 * 设计稿：整体水平居中，间距 56；单项宽 42，图标 42 × 42。
 * 这里把图标放大到 48（+14%），同时把间距收到 48 ——
 * 4 × 48 + 3 × 48 = 336，与设计稿的 4 × 42 + 3 × 56 = 336 相同，
 * 整排宽度不变，只是图标更大、间距更紧。
 */
.orders__items {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-top: calc(30 / 430 * 100vw);
  column-gap: calc(48 / 430 * 100vw);
}

.order {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(48 / 430 * 100vw);
}

.order--hover {
  opacity: 0.6;
}

.order__icon {
  width: calc(48 / 430 * 100vw);
  height: calc(48 / 430 * 100vw);
}

/*
 * 订单状态文字（待付款 / 待使用 / 已完成 / 已取消）
 * --------------------------------------------------------------------------
 * 设计稿改版：13px Regular → 16px Medium
 *   实测依据：字墨宽 37 → 46（「待付款」三字的墨迹宽，反推字号 13 → 16）；
 *             竖笔画宽 1.0 → 1.5（换算到 em 约为 0.11em，对应 PingFang Medium）。
 * ⚠️ 这里的 500 是安全的：文字走 --font-sans（PingFang SC 系统字体），
 *    自带真实 Medium 字重，不会像自定义思源宋体子集那样被「合成加粗」。
 */
.order__label {
  margin-top: calc(8 / 430 * 100vw);
  font-family: var(--font-sans);
  font-size: calc(16 / 430 * 100vw);
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-level-1);
}

/* ==========================================================================
   5.2 功能菜单
   --------------------------------------------------------------------------
   设计稿：四行自上而下 423 / 500 / 577 / 653，行高 77 / 77 / 76 / 77。
          （423 = 订单区块底 422 + 1）
   每行：左侧「图标 + 文字」一组（间距 19，末行 20），右侧统一 ›（右边距 20）。
   ========================================================================== */
/*
 * ⚠️ 四行的左内边距 / 图标槽 / 间距必须完全一致
 * --------------------------------------------------------------------------
 * 设计稿四行的左内边距是 21 / 20 / 21 / 20、图标宽 32.48 / 26.72 / 32 / 32、
 * 间距 19 / 19 / 19 / 20 —— 于是「我的讲解」那行的文字落在 x≈67，
 * 另外三行落在 x≈73，真机上看起来就是「上面两行偏左、没对齐」。
 *
 * 这里改成统一规格（对齐「帮助与反馈」那一行）：
 *   左内边距 20 ｜ 图标槽 32.5 × 34.2（最宽的那个图标撑出来的槽，图标在槽内居中）
 *   ｜ 图标槽与文字间距 20
 * → 四行文字一律落在 x = 20 + 32.5 + 20 = 72.5，图标视觉中心也在同一条竖线上。
 * 各图标仍保持设计稿的原始尺寸，只是被放进同一个槽里居中。
 */
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-right: calc(20 / 430 * 100vw);
  padding-left: calc(20 / 430 * 100vw);
  background-color: var(--bg-default);
}

.menu-row--hover {
  opacity: 0.6;
}

.menu-row__left {
  display: flex;
  align-items: center;
  column-gap: calc(20 / 430 * 100vw);
}

/* 统一图标槽：宽取四个图标里最宽的 32.4766（向上取 32.5），高取最高的 34.2 */
.menu-row__icon {
  flex-shrink: 0;
  width: calc(32.5 / 430 * 100vw);
  height: calc(34.2 / 430 * 100vw);
}

.menu-row__label {
  font-family: var(--font-sans);
  font-size: calc(18 / 430 * 100vw);
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-level-1);
}

/* 四行只保留各自的行高（77/77/76/77），左右内边距与图标槽都用上面的统一值 */
.menu-row--booking {
  height: calc(77 / 430 * 100vw);
}

.menu-row--guide {
  height: calc(77 / 430 * 100vw);
}

.menu-row--message {
  height: calc(76 / 430 * 100vw);
}

.menu-row--help {
  height: calc(77 / 430 * 100vw);
}

/*
 * 「空心圆 + 问号」
 * 设计稿里圆圈是素材、问号是文字（24px PingFang Medium，图标主色），
 * 两者叠放 —— 所以这里用相对定位把问号压在圆圈正中。
 * 外层尺寸与其它三行的 .menu-row__icon 取同一个槽（32.5 × 34.2），
 * 圆圈在内居中，四行的图标基线才落在同一条竖线上。
 */
.menu-row__help-icon {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: calc(32.5 / 430 * 100vw);
  height: calc(34.2 / 430 * 100vw);
}

.menu-row__help-circle {
  width: calc(32 / 430 * 100vw);
  height: calc(32 / 430 * 100vw);
}

.menu-row__help-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  font-family: var(--font-sans);
  font-size: calc(24 / 430 * 100vw);
  font-weight: 500;
  line-height: 1;
  color: var(--icon-primary);
  transform: translate(-50%, -50%);
}
