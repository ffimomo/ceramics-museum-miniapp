/* 底部导航（自定义 TabBar）的样式已抽到公共文件，避免各页面各写一份而走样：
   styles/tabbar.wxss
   ⚠️ @import 必须写在文件最前面。 */
@import "../../styles/tabbar.wxss";

/* ==========================================================================
   pages/index/index.wxss — 首页样式
   --------------------------------------------------------------------------
   设计稿基准：430 × 932 pt（iPhone 15 Pro） → 1px = 0.23256vw
   单位方案：vw（与 app.wxss 约定一致，水平尺寸 + 字号 + 字间距走 vw）
   色值 / 字号：优先引用 app.wxss 语义令牌（--text-level-1 / --bg-default 等）

   结构：一、Banner / 二、内容卡片 / 三、底部导航
   ========================================================================== */

/* ==========================================================================
   一、页面容器
   ========================================================================== */
.page {
  min-height: 100vh;
  background-color: var(--bg-default);
  /* 底部预留底栏高度，避免末卡被固定导航遮挡（--tabbar-h 见 styles/tabbar.wxss） */
  padding-bottom: var(--tabbar-h);
}

/*
 * 入场转场已统一到公共样式：app.wxss 的 .page-fade / .page-fade--hidden
 * （由 utils/transition.js 驱动，全站 8 个页面共用一套）。
 *
 * ⚠️ 这里只做 opacity，【没有 transform】—— 这是刻意的：
 *    元素只要有 transform（哪怕值是 translateY(0)）就会成为后代
 *    position: fixed 的包含块。.tabbar 是 .page 的后代，一旦 .page 带了
 *    transform，底部导航就不再相对「屏幕」定位、而是跟着内容滚到页面最底部，
 *    表现为「只有滑到底才看得见导航」。
 *    纯 opacity 不会创建这种包含块，所以整页（含底栏）一起淡出是安全的。
 *    若以后要给转场加位移，必须把动画挪到 .hero / .content-card 这类
 *    TabBar 的【兄弟节点】上，不能加在 .page。
 */

/* ==========================================================================
   二、顶部 Banner
   --------------------------------------------------------------------------
   通栏大图，aspectFill 铺满并保持比例（cover）。
   ========================================================================== */
.hero {
  width: 100%;
  /*
   * 设计稿：Banner 底边约在 y=360（在 x=2 处量得深色区域延伸到 y≈359.5），
   * 而内容卡片顶边在 y=346.5 —— 即卡片【上压】Banner 约 13.5px，
   * 露出上面两个圆角的裁切。
   * 早期写 371 / -24：Banner 多 11px、卡片多压 10.5px，两者叠加让
   * 「今日开馆」以下的所有内容整体下移了约 21px。
   */
  height: calc(360 / 430 * 100vw);
  overflow: hidden;
}

.hero__img {
  width: 100%;
  height: 100%;
}

/* ==========================================================================
   三、内容卡片（圆角上浮叠于 Banner 之上）
   --------------------------------------------------------------------------
   通过负 margin 上移 24px 与 Banner 底部重叠，顶部 20px 圆角。
   内边距：上 20 / 左右 26 / 下 29（下 29 = 末卡底部到卡片底部的留白）。
   ========================================================================== */
.content-card {
  position: relative;
  z-index: 1;
  /* 卡片顶边 346.5，Banner 底边 360 → 上压 13.5 */
  margin-top: calc(-13.5 / 430 * 100vw);
  /* 上 18：卡片顶 346.5 →「今日开馆」行盒顶 364.2（设计稿间距 17.7） */
  padding: calc(18 / 430 * 100vw) calc(26 / 430 * 100vw) calc(29 / 430 * 100vw);
  background-color: var(--bg-default);
  /* 设计稿实测圆角约 16（角弧从 x=17.4/y=346.5 收到 x=2.2/y=361） */
  border-radius: calc(16 / 430 * 100vw) calc(16 / 430 * 100vw) 0 0;
}

/* --------------------------------------------------------------------------
   1. 今日开馆（标题 + 日期）
   -------------------------------------------------------------------------- */
.today {
  display: flex;
  align-items: baseline;
}

.today__title {
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  color: var(--text-level-1);
}

.today__date {
  margin-left: calc(9 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(12 / 430 * 100vw);
  letter-spacing: calc(0.24 / 430 * 100vw);
  color: var(--text-level-1);
}

/* --------------------------------------------------------------------------
   2. 顶部双栏卡片区（票务预约大卡 + 右侧小卡列）
   -------------------------------------------------------------------------- */
.grid-top {
  display: flex;
  margin-top: calc(11 / 430 * 100vw);
}

.grid-top__side {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-left: calc(14 / 430 * 100vw);
}

/* --- 票务预约大卡（240.5 × 154.7） ---
   设计稿：x 26.1→266.6、y 404.6→559.3 */
.ticket {
  position: relative;
  flex-shrink: 0;
  width: calc(240.5 / 430 * 100vw);
  height: calc(154.7 / 430 * 100vw);
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
  /* 暖棕底：设计稿专用色（不在 app.wxss 令牌表内） */
  background-color: #a7977e;
}

.ticket__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.ticket__title {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(42 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(28 / 430 * 100vw);
  letter-spacing: calc(0.56 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-inverse);
}

.ticket__sub {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(88 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(16 / 430 * 100vw);
  letter-spacing: calc(0.32 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-inverse);
}

/* --- 小卡（123.5 × 71.5，右侧上下两枚） ---
   设计稿：上卡 406.8→476.5、下卡 488.1→557.8，单张高 71.5、间距 11.6；
   两枚合起来 154.7，与左侧票务大卡等高。 */
.mini-card {
  position: relative;
  width: 100%;
  height: calc(71.5 / 430 * 100vw);
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
}

.mini-card + .mini-card {
  margin-top: calc(11.7 / 430 * 100vw);
}

.mini-card__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mini-card__title {
  position: absolute;
  left: calc(10 / 430 * 100vw);
  top: calc(17 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  letter-spacing: calc(0.3 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.mini-card__sub {
  position: absolute;
  left: calc(10 / 430 * 100vw);
  top: calc(41 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(11 / 430 * 100vw);
  letter-spacing: calc(0.22 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

/* --------------------------------------------------------------------------
   3. 分割线（360 × 1，居中）
   -------------------------------------------------------------------------- */
.divider {
  width: calc(360 / 430 * 100vw);
  height: 1px;
  margin-top: calc(24 / 430 * 100vw);
  margin-right: auto;
  margin-left: auto;
  background-color: var(--border-default);
}

/* --------------------------------------------------------------------------
   4. 区块标题「陶瓷文化之旅」
   -------------------------------------------------------------------------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(23 / 430 * 100vw);
}

.section-head__title {
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.section-head__more {
  display: flex;
  align-items: center;
}

.section-head__more--hover {
  opacity: 0.7;
}

.section-head__more-text {
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(13 / 430 * 100vw);
  letter-spacing: calc(0.26 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-2);
}

/* 右箭头 ›：CSS 绘制（沿用项目「小图形用 CSS 绘制」惯例，不另出素材） */
.section-head__chevron {
  width: calc(8 / 430 * 100vw);
  height: calc(8 / 430 * 100vw);
  margin-left: calc(4 / 430 * 100vw);
  border-top: 1px solid var(--text-level-2);
  border-right: 1px solid var(--text-level-2);
  transform: rotate(45deg);
}

/* --------------------------------------------------------------------------
   5. 展览卡片（378 × 120）
   -------------------------------------------------------------------------- */
.exhibit-card {
  position: relative;
  height: calc(120 / 430 * 100vw);
  margin-top: calc(15 / 430 * 100vw); /* 首卡与区块标题的间距 */
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
}

/* 后续卡片之间的间距（120 高 + 16 间距 = 136 步进） */
.exhibit-card + .exhibit-card {
  margin-top: calc(16 / 430 * 100vw);
}

.exhibit-card__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.exhibit-card__title {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(28 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.exhibit-card__sub {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(61 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(13 / 430 * 100vw);
  letter-spacing: calc(0.26 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

/* 反色卡片（深底图 → 白色文字）：陶瓷文物 / 陶瓷手作 */
.exhibit-card--inverse .exhibit-card__title,
.exhibit-card--inverse .exhibit-card__sub {
  color: var(--text-inverse);
}

/* --------------------------------------------------------------------------
   卡片按压反馈（通用）
   -------------------------------------------------------------------------- */
.card-hover {
  opacity: 0.85;
}
