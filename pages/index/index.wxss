/* ==========================================================================
   pages/index/index.wxss — 首页样式
   --------------------------------------------------------------------------
   设计稿基准：430 × 932 pt（iPhone 15 Pro） → 1px = 0.23256vw
   单位方案：vw（与 app.wxss 约定一致，水平尺寸 + 字号 + 字间距走 vw）
   色值 / 字号：优先引用 app.wxss 语义令牌（--text-level-1 / --bg-default 等）

   结构：一、Banner / 二、内容卡片 / 三、底部导航
   ========================================================================== */

/* ==========================================================================
   一、页面容器
   ========================================================================== */
.page {
  min-height: 100vh;
  background-color: var(--bg-default);
  /* 底部预留 TabBar 高度，避免短屏机型上末卡被固定导航遮挡 */
  padding-bottom: calc(68 / 430 * 100vw);
}

/* ==========================================================================
   二、顶部 Banner
   --------------------------------------------------------------------------
   通栏大图，aspectFill 铺满并保持比例（cover）。
   ========================================================================== */
.hero {
  width: 100%;
  height: calc(371 / 430 * 100vw);
  overflow: hidden;
}

.hero__img {
  width: 100%;
  height: 100%;
}

/* ==========================================================================
   三、内容卡片（圆角上浮叠于 Banner 之上）
   --------------------------------------------------------------------------
   通过负 margin 上移 24px 与 Banner 底部重叠，顶部 20px 圆角。
   内边距：上 20 / 左右 26 / 下 29（下 29 = 末卡底部到卡片底部的留白）。
   ========================================================================== */
.content-card {
  position: relative;
  z-index: 1;
  margin-top: calc(-24 / 430 * 100vw);
  padding: calc(20 / 430 * 100vw) calc(26 / 430 * 100vw) calc(29 / 430 * 100vw);
  background-color: var(--bg-default);
  border-radius: calc(20 / 430 * 100vw) calc(20 / 430 * 100vw) 0 0;
}

/* --------------------------------------------------------------------------
   1. 今日开馆（标题 + 日期）
   -------------------------------------------------------------------------- */
.today {
  display: flex;
  align-items: baseline;
}

.today__title {
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  color: var(--text-level-1);
}

.today__date {
  margin-left: calc(9 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(12 / 430 * 100vw);
  letter-spacing: calc(0.24 / 430 * 100vw);
  color: var(--text-level-1);
}

/* --------------------------------------------------------------------------
   2. 顶部双栏卡片区（票务预约大卡 + 右侧小卡列）
   -------------------------------------------------------------------------- */
.grid-top {
  display: flex;
  margin-top: calc(11 / 430 * 100vw);
}

.grid-top__side {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-left: calc(14 / 430 * 100vw);
}

/* --- 票务预约大卡（240 × 156） --- */
.ticket {
  position: relative;
  flex-shrink: 0;
  width: calc(240 / 430 * 100vw);
  height: calc(156 / 430 * 100vw);
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
  /* 暖棕底：设计稿专用色（不在 app.wxss 令牌表内） */
  background-color: #a7977e;
}

.ticket__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.ticket__title {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(42 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(28 / 430 * 100vw);
  letter-spacing: calc(0.56 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-inverse);
}

.ticket__sub {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(88 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(16 / 430 * 100vw);
  letter-spacing: calc(0.32 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-inverse);
}

/* --- 小卡（124 × 74，右侧上下两枚） --- */
.mini-card {
  position: relative;
  width: 100%;
  height: calc(74 / 430 * 100vw);
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
}

.mini-card + .mini-card {
  margin-top: calc(8 / 430 * 100vw);
}

.mini-card__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.mini-card__title {
  position: absolute;
  left: calc(10 / 430 * 100vw);
  top: calc(17 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  letter-spacing: calc(0.3 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.mini-card__sub {
  position: absolute;
  left: calc(10 / 430 * 100vw);
  top: calc(41 / 430 * 100vw);
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(11 / 430 * 100vw);
  letter-spacing: calc(0.22 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

/* --------------------------------------------------------------------------
   3. 分割线（360 × 1，居中）
   -------------------------------------------------------------------------- */
.divider {
  width: calc(360 / 430 * 100vw);
  height: 1px;
  margin-top: calc(24 / 430 * 100vw);
  margin-right: auto;
  margin-left: auto;
  background-color: var(--border-default);
}

/* --------------------------------------------------------------------------
   4. 区块标题「陶瓷文化之旅」
   -------------------------------------------------------------------------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(23 / 430 * 100vw);
}

.section-head__title {
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.section-head__more {
  display: flex;
  align-items: center;
}

.section-head__more--hover {
  opacity: 0.7;
}

.section-head__more-text {
  font-family: var(--font-sans);
  font-weight: 300; /* 设计稿：PingFang SC Light */
  font-size: calc(13 / 430 * 100vw);
  letter-spacing: calc(0.26 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-2);
}

/* 右箭头 ›：CSS 绘制（沿用项目「小图形用 CSS 绘制」惯例，不另出素材） */
.section-head__chevron {
  width: calc(8 / 430 * 100vw);
  height: calc(8 / 430 * 100vw);
  margin-left: calc(4 / 430 * 100vw);
  border-top: 1px solid var(--text-level-2);
  border-right: 1px solid var(--text-level-2);
  transform: rotate(45deg);
}

/* --------------------------------------------------------------------------
   5. 展览卡片（378 × 120）
   -------------------------------------------------------------------------- */
.exhibit-card {
  position: relative;
  height: calc(120 / 430 * 100vw);
  margin-top: calc(15 / 430 * 100vw); /* 首卡与区块标题的间距 */
  overflow: hidden;
  border-radius: calc(8 / 430 * 100vw);
}

/* 后续卡片之间的间距（120 高 + 16 间距 = 136 步进） */
.exhibit-card + .exhibit-card {
  margin-top: calc(16 / 430 * 100vw);
}

.exhibit-card__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.exhibit-card__title {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(28 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(20 / 430 * 100vw);
  letter-spacing: calc(0.4 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

.exhibit-card__sub {
  position: absolute;
  left: calc(24 / 430 * 100vw);
  top: calc(61 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(13 / 430 * 100vw);
  letter-spacing: calc(0.26 / 430 * 100vw);
  white-space: nowrap;
  color: var(--text-level-1);
}

/* 反色卡片（深底图 → 白色文字）：陶瓷文物 / 陶瓷手作 */
.exhibit-card--inverse .exhibit-card__title,
.exhibit-card--inverse .exhibit-card__sub {
  color: var(--text-inverse);
}

/* --------------------------------------------------------------------------
   卡片按压反馈（通用）
   -------------------------------------------------------------------------- */
.card-hover {
  opacity: 0.85;
}

/* ==========================================================================
   四、底部导航（自定义 TabBar，固定底部）
   --------------------------------------------------------------------------
   外层负责白色底 + 顶部 1px 边框 + 底部安全区；
   内层负责 68px 内容区（4 个 item 等距分布）。
   ========================================================================== */
.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background-color: var(--bg-white);
  border-top: 1px solid var(--border-default);
  /* 底部安全区（iPhone 底部小黑条） */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar__list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: calc(68 / 430 * 100vw);
  padding-right: calc(36 / 430 * 100vw);
  padding-left: calc(36 / 430 * 100vw);
}

.tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(36 / 430 * 100vw);
}

.tabbar__item--hover {
  opacity: 0.7;
}

.tabbar__icon {
  width: calc(32 / 430 * 100vw);
  height: calc(32 / 430 * 100vw);
}

.tabbar__label {
  margin-top: calc(4 / 430 * 100vw);
  font-family: var(--font-sans);
  font-size: calc(17 / 430 * 100vw);
  line-height: 1;
  white-space: nowrap;
  color: var(--text-level-2); /* 未激活：二级文字 */
}

/* 激活态：一级文字 + Medium 字重（PingFang SC 自带真实 Medium，非合成加粗） */
.tabbar__item--active .tabbar__label {
  font-weight: 500;
  color: var(--text-level-1);
}
