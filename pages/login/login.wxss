/* ==========================================================================
   pages/login/login.wxss — 登录页样式
   --------------------------------------------------------------------------
   设计稿：W430 × H932（iPhone 15 Pro）
   单位方案：与启动页统一 —— vw 等比缩放
             calc(N / 430 * 100vw)，其中 N 为设计稿 mm 标注的 px 值

   ⚠️ 布局策略（与启动页一致的「双轨制」）
   --------------------------------------------------------------------------
   水平方向 + 字号  → vw 等比缩放（任何机型宽度下比例一致）
   垂直方向构图     → flex 比例分配（任何屏高下构图稳定，不漂移）
   ========================================================================== */

/* ==========================================================================
   一、页面根容器
   ========================================================================== */
.login {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: #f2ece1; /* 米黄宣纸兜底色，与设计稿背景基调一致 */
}

/* ==========================================================================
   二、背景层
   --------------------------------------------------------------------------
   叠放顺序（由下到上）：
     .login 根容器        backgroundColor 兜底底色（z-index auto，最底层）
     .login__bg           z-index: 1   ← 背景照片，压在兜底底色之上
     .login__content      z-index: 2   ← 页面内容，压在所有背景之上

   ⚠️ 曾出现过的坑：兜底层与照片都用绝对定位时，一旦 z-index 赋反
      （兜底层高于照片），不透明的兜底渐变会整屏盖住照片，
      表现为「真机上背景不见了」。
      现在兜底色由 .login 根容器的 backgroundColor 承担 ——
      它是容器自身的背景，天然在所有子元素之下，不存在层级赋反的可能。
   ========================================================================== */

/* 背景照片（唯一背景层） */
.login__bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  /* 图片加载失败时，透出 .login 根容器的米黄底色，不会露白 */
}

/* ==========================================================================
   三、内容层（三段式纵向布局）
   --------------------------------------------------------------------------
   品牌区（顶部） : 表单区（中部，占比最大） : 第三方区（底部）
   用 flex 比例分配保证不同屏高下构图稳定
   ========================================================================== */
.login__content {
  position: relative;
  z-index: 2; /* 压在两层背景之上 */
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  /* 左右安全边距：设计稿内容区左右各 65px（430 宽下） */
  padding-right: calc(28 / 430 * 100vw);
  padding-left: calc(28 / 430 * 100vw);
  /* 顶部避开状态栏 */
  padding-top: calc(var(--status-bar-h, 44) + 20px);
  /* 底部避开 Home Indicator */
  padding-bottom: calc(16 / 430 * 100vw);
  padding-bottom: calc(16 / 430 * 100vw + env(safe-area-inset-bottom));
}

/* ==========================================================================
   四、品牌区（Logo + 馆名）
   ========================================================================== */
.brand {
  display: flex;
  flex: 0 0 auto; /* 不参与 flex 分配，高度由内容决定 */
  flex-direction: column;
  align-items: center;
  width: 100%;
  /* 与下方表单区之间的间距 */
  margin-bottom: calc(74 / 430 * 100vw);
}

/*
 * Logo
 * --------------------------------------------------------------------------
 * 设计稿：花瓶线稿约 108 × 130 px（@2x），逻辑约 54 × 65
 * ⚠️ 素材为竖长形，宽高比保持 54 : 65，不要强行改成正方形
 */
.brand__logo {
  display: block;
  width: calc(62 / 430 * 100vw);
  height: calc(75 / 430 * 100vw);
  /* 没有图时隐藏，避免出现破图占位 */
  opacity: 1;
}

/*
 * Logo 占位框样式已移除
 * --------------------------------------------------------------------------
 * 素材未到位时曾在 WXML 里放过虚线占位框，现 Logo 素材已接入，
 * 占位节点早已从 WXML 删除，相关样式成为无效代码，一并清理。
 * 若将来需要临时占位，可在 WXML 中重新加回节点时再补样式。
 */

/* 中文馆名：设计稿约 24px，宋体，深棕色 */
.brand__name-cn {
  display: block;
  margin-top: calc(14 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(24 / 430 * 100vw);
  /*
   * ⚠️ 字重固定 400，不要改大
   * ----------------------------------------------------------------
   * 内嵌的思源宋体子集只有 Regular 一个字重（usWeightClass=400），
   * 且无可变字重轴（fvar）。若写 500 / 600，渲染器会做「合成加粗」
   * （faux bold，向四周描边），这会抹平宋体「横细竖粗」的笔画对比，
   * 视觉上退化成黑体 —— 这正是此前「宋体黑体混用」的根因之一。
   */
  font-weight: 400;
  line-height: 1.3;
  color: #3d332a;
  letter-spacing: 0.06em;
  text-align: center;
}

/* 英文馆名：设计稿约 15px，同样宋体（项目约定：英文也走 serif） */
.brand__name-en {
  display: block;
  margin-top: calc(2 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  font-weight: 400;
  line-height: 1.4;
  color: #3d332a;
  letter-spacing: 0.04em;
  text-align: center;
}

/* ==========================================================================
   五、登录表单区
   ========================================================================== */
.form {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

/* 标题「欢迎登陆」：设计稿约 30px，宋体，深色 */
.form__title {
  display: block;
  margin-bottom: calc(30 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(30 / 430 * 100vw);
  font-weight: 400; /* 同上：字体仅 Regular，禁止合成加粗 */
  line-height: 1.3;
  color: #2f2923;
  letter-spacing: 0.04em;
}

/* --------------------------------------------------------------------------
   输入框（手机号 / 密码 共用）
   --------------------------------------------------------------------------
   设计稿：浅色描边胶囊圆角矩形，高度约 62px，圆角约 10px
   -------------------------------------------------------------------------- */
.field {
  display: flex;
  align-items: center;
  width: 100%;
  height: calc(62 / 430 * 100vw);
  margin-bottom: calc(20 / 430 * 100vw);
  padding: 0 calc(18 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.55);
  border-radius: calc(10 / 430 * 100vw);
  background-color: rgba(255, 253, 248, 0.55);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

/* 聚焦态：描边变深、底色更亮 */
.field--focus {
  border-color: var(--brand-primary);
  background-color: rgba(255, 253, 248, 0.82);
}

/* 左侧 icon */
.field__icon {
  flex-shrink: 0;
  width: calc(20 / 430 * 100vw);
  height: calc(20 / 430 * 100vw);
}

/*
 * icon 与输入区之间的竖分隔线（设计稿中有这条细线）
 * --------------------------------------------------------------------------
 * 高度约为输入框的一半，颜色浅于边框
 */
.field__sep {
  flex-shrink: 0;
  width: 1px;
  height: calc(26 / 430 * 100vw);
  margin-left: calc(12 / 430 * 100vw);
  background-color: rgba(168, 148, 122, 0.42);
}

/* icon 占位（素材未填时可见）—— 填好图后可删除此节点 */
.field__icon-placeholder {
  flex-shrink: 0;
  width: calc(20 / 430 * 100vw);
  height: calc(20 / 430 * 100vw);
  border: 1px dashed rgba(122, 98, 74, 0.35);
  border-radius: calc(4 / 430 * 100vw);
}

.field__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 calc(14 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(17 / 430 * 100vw);
  color: #2f2923;
}

.field__placeholder {
  font-family: var(--font-serif);
  font-size: calc(17 / 430 * 100vw);
  color: rgba(122, 106, 88, 0.62);
}

/* 右侧眼睛按钮 */
.field__eye {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: calc(34 / 430 * 100vw);
  height: calc(34 / 430 * 100vw);
  margin-left: calc(6 / 430 * 100vw);
}

.field__eye--hover {
  opacity: 0.6;
}

.field__eye-icon {
  width: calc(22 / 430 * 100vw);
  height: calc(22 / 430 * 100vw);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

/*
 * 说明：眼睛的明/暗文态由两张独立素材切换，不再靠 CSS 模拟
 * --------------------------------------------------------------------------
 * - 睁眼 icon-eye.png       -> showPassword 为 true（明文）时显示
 * - 闭眼 icon-eye-close.png -> showPassword 为 false（密文）时显示
 * 两张图同源同色（--icon-secondary #B7AA9A），按 24x24 渲染时视觉重心
 * 相差 0.26px，切换时无跳动。切换逻辑见 login.js 的 togglePassword()。
 *
 * 历史：素材只有一张睁眼图时，曾用一个修饰类降透明度 + 微缩来模拟闭眼；
 *      闭眼图补齐后，该规则与 WXML 中的对应类名均已移除。
 */

/* 眼睛 icon 占位（素材未填时可见）—— 填好图后可删除此节点 */
.field__eye-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(22 / 430 * 100vw);
  height: calc(22 / 430 * 100vw);
  margin-top: calc(-22 / 430 * 100vw);
  border: 1px dashed rgba(122, 98, 74, 0.3);
  border-radius: 50%;
}

.field__eye-placeholder-text {
  font-size: calc(11 / 430 * 100vw);
  line-height: 1;
  opacity: 0.5;
}

/* --------------------------------------------------------------------------
   记住密码 / 忘记密码 一行
   -------------------------------------------------------------------------- */
.form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: calc(4 / 430 * 100vw);
  margin-bottom: calc(38 / 430 * 100vw);
}

.remember {
  display: flex;
  align-items: center;
}

/* 圆形勾选框：设计稿为圆形空心圈 */
.remember__box {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: calc(20 / 430 * 100vw);
  height: calc(20 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.75);
  border-radius: 50%;
  background-color: transparent;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

/* 勾选态：填充品牌色 */
.remember__box--checked {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary);
}

/*
 * 勾选标记：纯 CSS 绘制，不用字符
 * --------------------------------------------------------------------------
 * 原本用一个对勾字符（U+2713）来显示，但该字符不在内嵌的思源宋体子集里
 * （思源宋体本身就不含这个符号），真机上会被系统用其他字体兜底渲染，
 * 既可能显示成豆腐块，也会破坏「全站宋体」的一致性。
 *
 * 改用两条边框旋转 45° 拼出的对勾：
 *   - 零字体依赖，任何机型、任何字体下渲染都一致
 *   - 不依赖字体文件是否包含该符号，不需要为它单独补字
 *   - 矢量绘制，任意缩放都清晰
 */
.remember__tick {
  display: block;
  width: calc(9 / 430 * 100vw);
  height: calc(5 / 430 * 100vw);
  margin-top: calc(-2 / 430 * 100vw); /* 视觉重心补偿：让对勾在圆内居中 */
  border-left: 2px solid var(--text-inverse);
  border-bottom: 2px solid var(--text-inverse);
  transform: rotate(-45deg);
  font-size: 0; /* 彻底屏蔽可能残留的字符渲染 */
}

.remember__label {
  margin-left: calc(9 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(16 / 430 * 100vw);
  color: #3d332a;
  letter-spacing: 0.02em;
}

/* 忘记密码链接 */
.form__forget {
  font-family: var(--font-serif);
  font-size: calc(16 / 430 * 100vw);
  color: var(--brand-primary);
  letter-spacing: 0.02em;
}

/* --------------------------------------------------------------------------
   登录按钮
   --------------------------------------------------------------------------
   设计稿：棕色实心、白色文字、圆角约 10px、宽约 90% 居中
   -------------------------------------------------------------------------- */
.btn-login {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: calc(62 / 430 * 100vw);
  margin: 0 auto;
  border-radius: calc(10 / 430 * 100vw);
  background-color: transparent; /* 实际色在下面覆盖 */
  font-family: var(--font-serif);
  font-size: calc(21 / 430 * 100vw);
  font-weight: 400; /* 同上：字体仅 Regular，禁止合成加粗 */
  line-height: 1;
  color: var(--text-inverse);
  letter-spacing: 0.08em;
  /* 去掉原生 button 的默认边框 */
  border: none;
  /* 主色背景 */
  background-color: #a87c52;
}

.btn-login--hover {
  opacity: 0.88;
}

.btn-login[disabled] {
  opacity: 0.6;
}

/* --------------------------------------------------------------------------
   注册引导
   -------------------------------------------------------------------------- */
.form__register {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: calc(20 / 430 * 100vw);
}

.form__register-label {
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  color: #6f6355;
  letter-spacing: 0.02em;
}

/* 「去注册」棕色文字链接 */
.form__register-link {
  margin-left: calc(8 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  font-weight: 400; /* 同上：字体仅 Regular，禁止合成加粗 */
  color: var(--brand-primary);
  letter-spacing: 0.02em;
}

/* ==========================================================================
   六、第三方登录区
   ========================================================================== */
.third {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  width: 100%;
  /* 推到底部 */
  margin-top: auto;
  padding-bottom: calc(24 / 430 * 100vw);
}

/* 分割线 + 居中标题 */
.third__divider {
  display: flex;
  align-items: center;
  width: 100%;
}

.third__line {
  flex: 1;
  min-width: 0;
  height: 1px;
  background-color: rgba(168, 148, 122, 0.42);
}

.third__title {
  flex-shrink: 0;
  padding: 0 calc(14 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(15 / 430 * 100vw);
  color: #7b6e5e;
  letter-spacing: 0.04em;
}

/* 两个圆形按钮 */
.third__btns {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: calc(26 / 430 * 100vw);
  /* 两个按钮之间的间距 */
  column-gap: calc(44 / 430 * 100vw);
}

.third__btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(56 / 430 * 100vw);
  height: calc(56 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.48);
  border-radius: 50%;
  background-color: transparent;
  transition: background-color 0.18s ease;
}

.third__btn--hover {
  background-color: rgba(168, 148, 122, 0.12);
}

.third__btn-icon {
  width: calc(28 / 430 * 100vw);
  height: calc(28 / 430 * 100vw);
}

/*
 * 第三方按钮占位框样式已移除 —— 微信 / QQ 图标已接入，
 * 占位节点不在 WXML 中，保留样式只会成为无效代码。
 */
