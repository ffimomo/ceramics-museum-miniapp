/* ==========================================================================
   pages/login/login.wxss — 登录页样式
   --------------------------------------------------------------------------
   设计稿：W430 × H932（iPhone 15 Pro）
   单位方案：与启动页统一 —— vw 等比缩放
             calc(N / 430 * 100vw)，其中 N 为设计稿 mm 标注的 px 值

   ⚠️ 布局策略（与启动页一致的「双轨制」）
   --------------------------------------------------------------------------
   水平方向 + 字号  → vw 等比缩放（任何机型宽度下比例一致）
   垂直方向构图     → flex 比例分配（任何屏高下构图稳定，不漂移）
   ========================================================================== */

/* ==========================================================================
   一、页面根容器
   ========================================================================== */
.login {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background-color: #f2ece1; /* 米黄宣纸兜底色，与设计稿背景基调一致 */
  /* 入场转场已统一到公共样式：app.wxss 的 .page-fade / .page-fade--hidden */
}

/* ==========================================================================
   二、背景层
   ========================================================================== */
.login__bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}


/* ==========================================================================
   三、内容层（三段式纵向布局）
   --------------------------------------------------------------------------
   品牌区（顶部） : 表单区（中部，占比最大） : 第三方区（底部）
   用 flex 比例分配保证不同屏高下构图稳定
   ========================================================================== */
.login__content {
  position: relative;
  z-index: 2; /* 压在两层背景之上 */
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  /*
   * 左右安全边距 50px
   * ------------------------------------------------------------------
   * 设计稿实测：「登陆」按钮 / 输入框左右边缘都在 x = 50 与 x = 380，
   * 即内容宽 330、两侧各留 50。
   * ⚠️ 早期写的是 28（注释里还留着 65 的旧标注，三方对不上），
   *    会让表单横向铺得太满，与设计稿的「留白克制」观感不符。
   */
  padding-right: calc(50 / 430 * 100vw);
  padding-left: calc(50 / 430 * 100vw);
  /* 顶部避开状态栏 */
  padding-top: calc(var(--status-bar-h, 44) + 20px);
  /* 底部避开 Home Indicator */
  padding-bottom: calc(16 / 430 * 100vw);
  padding-bottom: calc(16 / 430 * 100vw + env(safe-area-inset-bottom));
}

/* ==========================================================================
   四、品牌区（Logo + 馆名）
   ========================================================================== */
.brand {
  display: flex;
  flex: 0 0 auto; /* 不参与 flex 分配，高度由内容决定 */
  flex-direction: column;
  align-items: center;
  width: 100%;
  /*
   * 品牌区 / 表单区 / 第三方区之间用「等分剩余空间」的方式拉开。
   * ------------------------------------------------------------------
   * 设计稿实测三段间距分别为 83.8 / 93.0 / 92.2 —— 基本相等，
   * 说明设计师用的就是「均分」而非逐个写死。
   * 因此三块各自 margin-top: auto，浏览器会把剩余空间平分成三份，
   * 任何屏高下间距都自洽，也不会像写死数值那样在高屏上被拉散。
   */
  margin-top: auto;
}

/*
 * Logo
 * --------------------------------------------------------------------------
 * 设计稿实测 63.2 × 83.5（比例 0.757）；素材 login-logo.png 为 64 × 85（比例 0.753），
 * 两者几乎一致，按 63.5 × 84.3 呈现即可满框不变形。
 * ⚠️ 早期写 62 × 75（比例 0.827），比例不符会让 aspectFit 上下留白，
 *    LOGO 实际被缩得比标注更小。
 */
.brand__logo {
  display: block;
  width: calc(63.5 / 430 * 100vw);
  height: calc(84.3 / 430 * 100vw);
  /* 没有图时隐藏，避免出现破图占位 */
  opacity: 1;
}

/*
 * Logo 占位框（素材未填时可见）
 * ⚠️ 图片填好后请删除 WXML 里的 .brand__logo-placeholder 节点，
 *    或保留也无妨（它绝对定位在 Logo 位置，会被图片覆盖）
 */
.brand__logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(62 / 430 * 100vw);
  height: calc(75 / 430 * 100vw);
  /* 与图片同位叠加 */
  margin-top: calc(-75 / 430 * 100vw);
  border: 1px dashed rgba(122, 98, 74, 0.35);
  border-radius: calc(6 / 430 * 100vw);
}

.brand__logo-placeholder-text {
  font-family: var(--font-sans);
  font-size: calc(10 / 430 * 100vw);
  color: rgba(122, 98, 74, 0.55);
  letter-spacing: 0.08em;
}

/* 中文馆名：设计稿字高 22.5 / 字宽 119（5 字）→ 字号约 23px，宋体，深棕色 */
.brand__name-cn {
  display: block;
  /*
   * ⚠️ 这里要填的是【行盒间距】不是【字墨间距】
   * LOGO 盒底 228.1 → 中文行盒顶 240.7（中文墨迹顶 245.5 已含约 4.8 的行高余量）
   * 早期误用字墨间距 18.9，会让品牌区整体高出一截。
   */
  margin-top: calc(12.5 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(23 / 430 * 100vw);
  font-weight: 400;
  line-height: 1.3;
  color: #3d332a;
  letter-spacing: 0.06em;
  text-align: center;
}

/* 英文馆名：设计稿整串字宽 148.9 → 字号约 18px，同样宋体（项目约定：英文也走 serif） */
.brand__name-en {
  display: block;
  /* 中文行盒底 270.6 → 英文行盒顶 271.7（同样按行盒而非字墨计算） */
  margin-top: calc(1 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(18 / 430 * 100vw);
  font-weight: 400;
  line-height: 1.2;
  color: #3d332a;
  letter-spacing: 0.04em;
  text-align: center;
}

/* ==========================================================================
   五、登录表单区
   ========================================================================== */
.form {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  min-height: 0;
  /* 与上方品牌区、下方第三方区均分剩余空间 */
  margin-top: auto;
}

/* 标题「欢迎登陆」：设计稿字高 26.1 / 字步进 29.3 → 字号约 28px，宋体，深色 */
.form__title {
  display: block;
  /* 标题行盒底 → 第一格输入框顶，设计稿间距 29.8 */
  margin-bottom: calc(30 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(28 / 430 * 100vw);
  font-weight: 400;
  line-height: 1.3;
  color: #2f2923;
  letter-spacing: 0.04em;
}

/* --------------------------------------------------------------------------
   输入框（手机号 / 密码 共用）
   --------------------------------------------------------------------------
   设计稿实测：顶边 y=440.2、底边 y=491.2 → 高 51px，圆角约 11px
   ⚠️ 早期写 62px（比设计稿高 11px，两格之间被撑开了 10px 的累计误差），
      是登录页纵向错位最明显的一处。
   -------------------------------------------------------------------------- */
.field {
  display: flex;
  align-items: center;
  width: 100%;
  height: calc(51 / 430 * 100vw);
  /* 两格间距：491.2 → 512.1，设计稿 20.9 */
  margin-bottom: calc(21 / 430 * 100vw);
  /* 左 14.5：框左 50.1 → 图标左 64.6（设计稿实测）；右 10：眼睛图标右 368.3 */
  padding: 0 calc(10 / 430 * 100vw) 0 calc(14.5 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.55);
  border-radius: calc(11 / 430 * 100vw);
  background-color: rgba(255, 253, 248, 0.55);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

/* 聚焦态：描边变深、底色更亮 */
.field--focus {
  border-color: var(--brand-primary);
  background-color: rgba(255, 253, 248, 0.82);
}

/* 左侧 icon：设计稿实测约 21 × 22.5（书签）/ 21 × 22.5（锁） */
.field__icon {
  flex-shrink: 0;
  width: calc(22 / 430 * 100vw);
  height: calc(22 / 430 * 100vw);
}

/*
 * icon 与输入区之间的竖分隔线（设计稿中有这条细线）
 * --------------------------------------------------------------------------
 * 高度约为输入框的一半，颜色浅于边框
 */
.field__sep {
  flex-shrink: 0;
  width: 1px;
  /* 设计稿：竖线高约 22.5，位于图标右 85.0 → 竖线 96.6（间距 11.6） */
  height: calc(22 / 430 * 100vw);
  margin-left: calc(10.5 / 430 * 100vw);
  background-color: rgba(168, 148, 122, 0.42);
}

/* icon 占位（素材未填时可见）—— 填好图后可删除此节点 */
.field__icon-placeholder {
  flex-shrink: 0;
  width: calc(20 / 430 * 100vw);
  height: calc(20 / 430 * 100vw);
  border: 1px dashed rgba(122, 98, 74, 0.35);
  border-radius: calc(4 / 430 * 100vw);
}

.field__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  /* 竖线 97.3 → 占位文字 106.8，设计稿间距 9.5 */
  padding: 0 calc(9.5 / 430 * 100vw);
  font-family: var(--font-serif);
  /* 设计稿占位文字字高 14.5 → 字号约 16px */
  font-size: calc(16 / 430 * 100vw);
  color: #2f2923;
}

.field__placeholder {
  font-family: var(--font-serif);
  font-size: calc(16 / 430 * 100vw);
  color: rgba(122, 106, 88, 0.62);
}

/* 右侧眼睛按钮 */
.field__eye {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: calc(34 / 430 * 100vw);
  height: calc(34 / 430 * 100vw);
  margin-left: calc(6 / 430 * 100vw);
}

.field__eye--hover {
  opacity: 0.6;
}

.field__eye-icon {
  /* 设计稿实测眼睛图标 24 × 18.2（素材 32 × 32，按 24 盒 aspectFit） */
  width: calc(24 / 430 * 100vw);
  height: calc(24 / 430 * 100vw);
}

/* 眼睛 icon 占位（素材未填时可见）—— 填好图后可删除此节点 */
.field__eye-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(22 / 430 * 100vw);
  height: calc(22 / 430 * 100vw);
  margin-top: calc(-22 / 430 * 100vw);
  border: 1px dashed rgba(122, 98, 74, 0.3);
  border-radius: 50%;
}

.field__eye-placeholder-text {
  font-size: calc(11 / 430 * 100vw);
  line-height: 1;
  opacity: 0.5;
}

/* --------------------------------------------------------------------------
   记住密码 / 忘记密码 一行
   -------------------------------------------------------------------------- */
.form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  /* 上一格输入框自带 21px 下边距（flex 下不与本行 margin 合并），这里不再追加 */
  margin-top: 0;
  /* 勾选行底 → 按钮顶，设计稿 18.2 */
  margin-bottom: calc(18 / 430 * 100vw);
  /*
   * 设计稿里这一行整体比按钮左右各内收约 10px
   * （勾选框左 59.4 / 按钮左 50.1，忘记密码右 361 / 按钮右 379.9）
   */
  padding-right: calc(12 / 430 * 100vw);
  padding-left: calc(9 / 430 * 100vw);
}

.remember {
  display: flex;
  align-items: center;
}

/*
 * 勾选框：设计稿是【圆角方形】而非圆形
 * --------------------------------------------------------------------------
 * 实测 20 × 20、圆角约 5px（线宽 1px，描边色与输入框一致）。
 * ⚠️ 早期写成 border-radius: 50%（正圆），与设计稿的方框造型不符。
 */
.remember__box {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: calc(20 / 430 * 100vw);
  height: calc(20 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.85);
  border-radius: calc(5 / 430 * 100vw);
  background-color: transparent;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

/* 勾选态：填充品牌色 */
.remember__box--checked {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary);
}

.remember__tick {
  font-family: var(--font-sans);
  font-size: calc(12 / 430 * 100vw);
  line-height: 1;
  color: var(--text-inverse);
}

.remember__label {
  margin-left: calc(9 / 430 * 100vw);
  font-family: var(--font-serif);
  /* 设计稿「记住密码」字宽 55 / 4 字 → 每字 13.75，字号约 14px（早期 16 偏大） */
  font-size: calc(14 / 430 * 100vw);
  color: #3d332a;
  letter-spacing: 0.02em;
}

/* 忘记密码链接：与「记住密码」同号 */
.form__forget {
  font-family: var(--font-serif);
  font-size: calc(14 / 430 * 100vw);
  color: var(--brand-primary);
  letter-spacing: 0.02em;
}

/* --------------------------------------------------------------------------
   登录按钮
   --------------------------------------------------------------------------
   设计稿：棕色实心、白色文字、圆角约 10px、宽约 90% 居中
   -------------------------------------------------------------------------- */
.btn-login {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  /* 设计稿实测按钮 y 623.2 → 674.8，高 51.6（早期 62 偏高 10px） */
  height: calc(52 / 430 * 100vw);
  margin: 0 auto;
  border-radius: calc(10 / 430 * 100vw);
  background-color: transparent; /* 实际色在下面覆盖 */
  font-family: var(--font-serif);
  /* 设计稿「登陆」字宽 37.8 / 字高 17.4 → 字号约 19.5px（早期 24 偏大） */
  font-size: calc(19.5 / 430 * 100vw);
  font-weight: 400;
  line-height: 1;
  color: var(--text-inverse);
  letter-spacing: 0.08em;
  /* 去掉原生 button 的默认边框 */
  border: none;
  /* 主色背景 */
  background-color: #a87c52;
}

.btn-login--hover {
  opacity: 0.88;
}

.btn-login[disabled] {
  opacity: 0.6;
}

/* --------------------------------------------------------------------------
   注册引导
   -------------------------------------------------------------------------- */
.form__register {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  /* 按钮底 674.8 → 注册行行盒顶 686.9，设计稿间距 12.1 */
  margin-top: calc(12 / 430 * 100vw);
}

.form__register-label {
  font-family: var(--font-serif);
  /* 整串「还没有注册？去注册」字宽 117.7 / 9 字 → 每字 13.1，字号约 13px */
  font-size: calc(13 / 430 * 100vw);
  color: #6f6355;
  letter-spacing: 0.02em;
}

/* 「去注册」棕色文字链接 */
.form__register-link {
  margin-left: calc(8 / 430 * 100vw);
  font-family: var(--font-serif);
  font-size: calc(13 / 430 * 100vw);
  font-weight: 400;
  color: var(--brand-primary);
  letter-spacing: 0.02em;
}

/* ==========================================================================
   六、第三方登录区
   ========================================================================== */
.third {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  width: 100%;
  /* 与上方品牌区、表单区均分剩余空间（三块各自的 margin-top:auto 平分） */
  margin-top: auto;
  /* 圆形按钮底 878.9 → 屏幕底 932，设计稿留白约 19（安全区另计） */
  padding-bottom: calc(19 / 430 * 100vw);
}

/* 分割线 + 居中标题 */
.third__divider {
  display: flex;
  align-items: center;
  width: 100%;
}

.third__line {
  flex: 1;
  min-width: 0;
  height: 1px;
  background-color: rgba(168, 148, 122, 0.42);
}

.third__title {
  flex-shrink: 0;
  /* 文字与两侧分割线的间距，设计稿约 24 */
  padding: 0 calc(24 / 430 * 100vw);
  font-family: var(--font-serif);
  /* 字宽 77.7 / 6 字 → 每字 12.95，字号约 13px */
  font-size: calc(13 / 430 * 100vw);
  color: #7b6e5e;
  letter-spacing: 0.04em;
}

/* 两个圆形按钮 */
.third__btns {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 「其他登陆方式」行盒底 809.4 → 圆形按钮顶 830.8，设计稿间距约 21 */
  margin-top: calc(21 / 430 * 100vw);
  /* 两个按钮之间的间距 */
  column-gap: calc(45 / 430 * 100vw);
}

.third__btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 设计稿实测直径约 49（早期 56 偏大） */
  width: calc(49 / 430 * 100vw);
  height: calc(49 / 430 * 100vw);
  border: 1px solid rgba(168, 148, 122, 0.48);
  border-radius: 50%;
  background-color: transparent;
  transition: background-color 0.18s ease;
}

.third__btn--hover {
  background-color: rgba(168, 148, 122, 0.12);
}

.third__btn-icon {
  width: calc(34 / 430 * 100vw);
  height: calc(34 / 430 * 100vw);
}

/* icon 占位（素材未填时可见）—— 填好图后可删除此节点 */
.third__btn-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(28 / 430 * 100vw);
  height: calc(28 / 430 * 100vw);
  transform: translate(-50%, -50%);
  border: 1px dashed rgba(122, 98, 74, 0.32);
  border-radius: calc(4 / 430 * 100vw);
}

.third__btn-placeholder-text {
  font-family: var(--font-sans);
  font-size: calc(9 / 430 * 100vw);
  color: rgba(122, 98, 74, 0.6);
  letter-spacing: 0;
}
