<!-- ==========================================================================
     pages/login/login.wxml — 登录页
     --------------------------------------------------------------------------
     设计稿：W430 × H932（iPhone 15 Pro），与启动页同一基准

     结构（自上而下）：
       一、背景层（米黄宣纸质感，留空待填图）
       二、品牌区（花瓶线稿 Logo + 中英文馆名）
       三、登录表单区（标题 / 手机号 / 密码 / 记住密码 + 忘记密码 / 登录按钮 / 去注册）
       四、第三方登录区（分割线 + 微信、QQ 圆形按钮）

     ⚠️ 图片资源全部留空（背景、Logo、两个图标），见文件末尾「素材填写指引」注释。
     ========================================================================== -->
<view class="login" style="{{safeAreaStyle}}">

  <!-- ========================================================================
       一、背景层
       ------------------------------------------------------------------------
       米黄色宣纸 / 陶瓷质感背景图（已接入，src 直接指向本地素材）
       ⚠️ 换图改这里的 src，或改 login.js 的 data.bgImage 后回到 {{bgImage}} 绑定

       叠放顺序（由下到上）：
         1. .login 根容器        backgroundColor 兜底底色（z-index auto）
         2. .login__bg           背景照片，z-index 1
         3. .login__content      页面内容，z-index 2

       底色兜底由 .login 根容器的 background-color 承担，不再单独设节点。
       ======================================================================== -->
  <image
    class="login__bg"
    src="assets\images\login-bg.webp"
    mode="aspectFill"
    aria-hidden="true"
  />

  <!-- ========================================================================
       二、内容层
       ======================================================================== -->
  <view class="login__content">

    <!-- ===== 品牌区 ===== -->
    <view class="brand">

      <!-- 花瓶线稿 Logo
           ⚠️ 换图改 login.js 的 data.logoImage 即可 -->
      <image
        class="brand__logo"
        src="{{logoImage}}"
        mode="aspectFit"
        aria-label="陶瓷博物馆标志"
      />

      <text class="brand__name-cn">陶瓷博物馆</text>
      <text class="brand__name-en">Ceramics Museum</text>
    </view>

    <!-- ===== 登录表单区 ===== -->
    <view class="form">

      <!-- 标题：⚠️ 「欢迎登陆」按设计稿原文；规范写法应为「欢迎登录」 -->
      <text class="form__title">欢迎登陆</text>

      <!-- ------------------------------------------------------------------
           手机号输入框
           ------------------------------------------------------------------ -->
      <view class="field {{phoneFocus ? 'field--focus' : ''}}">
        <!-- 左侧书签 icon（Bookmark）
             ⚠️ 换图改 login.js 的 data.iconBookmark 即可 -->
        <image
          class="field__icon"
          src="{{iconBookmark}}"
          mode="aspectFit"
          aria-hidden="true"
        />

        <!-- icon 与输入区之间的竖分隔线（设计稿中有） -->
        <view class="field__sep" aria-hidden="true" />

        <input
          class="field__input"
          type="number"
          maxlength="11"
          value="{{phone}}"
          placeholder="请输入手机号"
          placeholder-class="field__placeholder"
          bindinput="onPhoneInput"
          bindfocus="onPhoneFocus"
          bindblur="onPhoneBlur"
          confirm-type="next"
        />
      </view>

      <!-- ------------------------------------------------------------------
           密码输入框
           ------------------------------------------------------------------ -->
      <view class="field {{pwdFocus ? 'field--focus' : ''}}">
        <!-- 左侧锁 icon
             ⚠️ 换图改 login.js 的 data.iconLock 即可 -->
        <image
          class="field__icon"
          src="{{iconLock}}"
          mode="aspectFit"
          aria-hidden="true"
        />

        <!-- icon 与输入区之间的竖分隔线（设计稿中有） -->
        <view class="field__sep" aria-hidden="true" />

        <input
          class="field__input"
          type="{{showPassword ? 'text' : 'password'}}"
          value="{{password}}"
          placeholder="请输入密码"
          placeholder-class="field__placeholder"
          bindinput="onPasswordInput"
          bindfocus="onPwdFocus"
          bindblur="onPwdBlur"
          confirm-type="done"
          bindconfirm="onLogin"
        />

        <!-- 眼睛 icon（右侧，明/暗文切换）
             ⚠️ 切换逻辑：src 绑定 {{eyeIcon}}，由 login.js 的
                togglePassword() 在 eyeIconOpen / eyeIconClose 之间切换。
                睁眼=明文态、闭眼=密文态，已是两张独立素材，无需额外类名。
                换图改 login.js 的 data 即可，不用动这里。 -->
        <view
          class="field__eye"
          bindtap="togglePassword"
          hover-class="field__eye--hover"
          aria-label="切换密码显示"
        >
          <image
            class="field__eye-icon"
            src="{{eyeIcon}}"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
      </view>

      <!-- ------------------------------------------------------------------
           记住密码 / 忘记密码
           ------------------------------------------------------------------ -->
      <view class="form__row">
        <view class="remember" bindtap="toggleRemember">
          <!-- ⚠️ 圆形勾选框：设计稿为圆形空心圈，勾选后填充
               对勾由 CSS 绘制（.remember__tick 的两条边框旋转而成），
               不用字符 —— 思源宋体子集不含 U+2713，用字符会落到兜底字体。
               如需换成图片 icon，把下面 view 替换为 image 即可 -->
          <view class="remember__box {{rememberPwd ? 'remember__box--checked' : ''}}">
            <view wx:if="{{rememberPwd}}" class="remember__tick" />
          </view>
          <text class="remember__label">记住密码</text>
        </view>

        <text class="form__forget" bindtap="goForgetPassword">忘记密码?</text>
      </view>

      <!-- ------------------------------------------------------------------
           登录按钮
           ------------------------------------------------------------------ -->
      <button
        class="btn-login"
        bindtap="onLogin"
        hover-class="btn-login--hover"
        loading="{{logging}}"
        disabled="{{logging}}"
      >
        {{logging ? '登录中...' : '登陆'}}
      </button>

      <!-- 注册引导 -->
      <view class="form__register">
        <text class="form__register-label">还没有注册？</text>
        <text class="form__register-link" bindtap="goRegister">去注册</text>
      </view>

    </view>

    <!-- ===== 第三方登录区 ===== -->
    <view class="third">

      <!-- 分割线 + 居中文字 -->
      <view class="third__divider">
        <view class="third__line" />
        <text class="third__title">其他登陆方式</text>
        <view class="third__line" />
      </view>

      <!-- 两个圆形按钮 -->
      <view class="third__btns">

        <!-- 微信登录图标
             ⚠️ 更换图标改 login.js 的 data.iconWechat 即可 -->
        <view class="third__btn" bindtap="onWechatLogin" hover-class="third__btn--hover">
          <image
            class="third__btn-icon"
            src="{{iconWechat}}"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>

        <!-- QQ 登录图标
             ⚠️ 更换图标改 login.js 的 data.iconQQ 即可 -->
        <view class="third__btn" bindtap="onQQLogin" hover-class="third__btn--hover">
          <image
            class="third__btn-icon"
            src="{{iconQQ}}"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>

      </view>
    </view>

  </view>

</view>
