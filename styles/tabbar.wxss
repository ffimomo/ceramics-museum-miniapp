/* ==========================================================================
   styles/tabbar.wxss — 底部导航（自定义 TabBar）公共样式
   --------------------------------------------------------------------------
   被 index / guide（以及后续的鉴赏、我的）用 @import 引入：
       @import "../../styles/tabbar.wxss";

   ⚠️ 为什么抽成公共文件
   --------------------------------------------------------------------------
   首页与导览页各自写过一份 .tabbar 样式，改首页时漏改了导览页，
   导致两页的导航栏高度（68 / 55）、图标尺寸（32×32 / 30×26）
   和底部安全区处理都不一致，真机上看起来像两个 App。
   抽成一份后，两页必然同步；以后新增带底栏的页面也直接 @import 即可。

   ⚠️ 使用前提：页面根节点不能有 transform
   --------------------------------------------------------------------------
   transform 会让元素成为后代 position: fixed 的包含块，
   .tabbar 就不再相对「屏幕」定位，而是跟着内容滚到页面底部。
   入场动画请加在内容节点上（见 index.wxss 的 .hero / .content-card），
   不要加在页面根节点。

   设计稿基准：430 × 932（iPhone 15 Pro）
   ========================================================================== */

/* ==========================================================================
   零、底栏总高变量
   --------------------------------------------------------------------------
   页面内容需要给底栏让位时，统一写 padding-bottom: var(--tabbar-h)，
   不要再各写各的魔数（首页写过 68/72、导览页写过 68+安全区，全对不上）。
   ========================================================================== */
page {
  --tabbar-h: calc(55 / 430 * 100vw + max(0px, env(safe-area-inset-bottom) - 17 / 430 * 100vw));
}

/* ==========================================================================
   一、外层：白底 + 顶部 1px 细线 + 底部安全区
   ========================================================================== */
.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background-color: var(--bg-white);
  border-top: 1px solid var(--border-default);
  /*
   * 底部安全区（iPhone 底部小黑条）
   * ------------------------------------------------------------------
   * 设计稿整条导航高 72（y 860→932），图标+文字这组内容居中占 52。
   * 但真机上安全区就吃掉 34，若照搬 72 内容就会被小黑条压住。
   * 折中：内容按设计稿的 55 走，「安全区里减去 17」的部分留给小黑条 ——
   * iPhone 15 Pro 上正好凑回 55 + (34-17) = 72，与设计稿等高；
   * 没有小黑条的机型则退化为 55，不留空档。
   */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  padding-bottom: max(0px, calc(env(safe-area-inset-bottom) - 17 / 430 * 100vw));
}

.tabbar__list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 图标 26 + 间距 8.4 + 文字行高 17 = 51.4，居中于 55 的内容区 */
  height: calc(55 / 430 * 100vw);
  padding-right: calc(36 / 430 * 100vw);
  padding-left: calc(36 / 430 * 100vw);
}

.tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(36 / 430 * 100vw);
}

.tabbar__item--hover {
  opacity: 0.7;
}

/* ==========================================================================
   二、图标
   --------------------------------------------------------------------------
   ⚠️ 图标颜色是「画进 PNG 里」的，不是靠 CSS 染色
   --------------------------------------------------------------------------
   激活态与未激活态是两套素材，切换激活项时必须换 src：
       未激活  /assets/icons/tab-{name}.png         浅暖灰 #b0a898
       激活    /assets/icons/tab-{name}-active.png  深棕   #6b5b4a
   四个 name：home / guide / appreciate / mine
   （对应 --icon-secondary / --icon-primary 两个令牌）

   尺寸用「定高 + 宽度自适应」而不是正方形盒：
   四张素材的高宽比并不一致（96×93 / 96×112 / 96×96 / 96×108，
   后两张自带上下留白），正方形盒会让导览 / 我的被压矮一截。
   ========================================================================== */
.tabbar__icon {
  width: calc(30 / 430 * 100vw);
  height: calc(26 / 430 * 100vw);
}

/* ==========================================================================
   三、文字
   ========================================================================== */
.tabbar__label {
  /* 图标底 → 文字行盒顶，设计稿间距 8.4 */
  margin-top: calc(8.4 / 430 * 100vw);
  font-family: var(--font-sans);
  font-size: calc(17 / 430 * 100vw);
  line-height: 1;
  white-space: nowrap;
  color: var(--text-level-2); /* 未激活：二级文字 */
}

/*
 * 激活态：一级文字 + Medium 字重
 * ⚠️ 这里的 500 是安全的：底栏文字走 --font-sans（PingFang SC 系统字体），
 *    自带真实 Medium 字重，不会像思源自定义子集那样被「合成加粗」。
 */
.tabbar__item--active .tabbar__label {
  font-weight: 500;
  color: var(--text-level-1);
}
